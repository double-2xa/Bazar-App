# Customer website production build environment. Copy to apps/mobile/.env.production.
EXPO_PUBLIC_API_URL=https://api.nicepricebazar.com/api
EXPO_PUBLIC_ADMIN_URL=https://admin.nicepricebazar.com

# Optional until Google login and native push notifications are configured.
# Web client ID (required — used by native Google Sign-In to return an ID token)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Optional iOS OAuth client ID (dev/prod builds)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Optional Android OAuth client ID (Google matches by package + SHA-1; keep for API verification)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_EAS_PROJECT_ID=
