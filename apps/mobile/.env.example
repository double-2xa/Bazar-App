# Use localhost for simulators; on a physical device use your PC's LAN IP instead.
# Example: http://192.168.1.10:3001/api
EXPO_PUBLIC_API_URL=http://localhost:3001/api
EXPO_PUBLIC_ADMIN_URL=http://localhost:3000

# Google Sign-In (same client IDs as API GOOGLE_CLIENT_ID_* where applicable)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-uuid
