{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.nicepricebazar.com/api",
        "EXPO_PUBLIC_ADMIN_URL": "https://admin.nicepricebazar.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
