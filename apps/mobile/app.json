{
  "expo": {
    "name": "Nice Price Bazar",
    "slug": "nice-price-bazar",
    "version": "1.0.0",
    "icon": "./assets/nice-price-bazar-icon-v2.png",
    "orientation": "portrait",
    "scheme": "nicepricebazar",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8E7"
    },
    "web": {
      "bundler": "metro"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nicepricebazar.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Nice Price Bazar uses your location to help you select an accurate delivery address."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/nice-price-bazar-icon-v2.png",
        "backgroundColor": "#C8102E"
      },
      "package": "com.nicepricebazar.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "autolinkingModuleResolution": true
    },
    "notification": {
      "color": "#C8102E",
      "androidMode": "default",
      "androidCollapsedTitle": "Nice Price Bazar"
    }
  }
}
