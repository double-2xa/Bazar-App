{
  "expo": {
    "name": "Nice Price Bazar",
    "slug": "nice-price-bazar",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nicepricebazar",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FFF8E7"
    },
    "web": {
      "bundler": "metro"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nicepricebazar.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#C8102E"
      },
      "package": "com.nicepricebazar.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "autolinkingModuleResolution": true
    }
  }
}
