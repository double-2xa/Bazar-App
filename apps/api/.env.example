# ============================================================
# DATABASE — PostgreSQL connection used by the running API
# ============================================================
DATABASE_URL=postgresql://bazar_muteren:Y50gJ0hOc9Mc3D@doublea-postgres18-ota-rw.aa-postgres18-ota.svc.cluster.local:5432/nicepricebazar-ota-db?schema=bazardb&connection_limit=10&pool_timeout=10&connect_timeout=5&socket_timeout=10&application_name=nicepricebazar_api
IMPORT_IMAGE_TIMEOUT_MS=12000
IMPORT_IMAGE_CONCURRENCY=5

# ============================================================
# LOGIN SECURITY — access tokens and refresh tokens
# Keep both secrets private and use different random values.
# ============================================================
JWT_ACCESS_SECRET=56e82069a949f3cf4e901207fe78829182846267beaca1d7c8b25b66db3c9660347f3c0c551a720712d37623e9e8c018
JWT_REFRESH_SECRET=eb81c53105961ce38bd7e3c6be4f3d0072efceda7eb3464c701e215714122138e29daf25b8e5e14c1caa268b8b4837ac
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ============================================================
# API SERVER — production mode, proxy, request and body limits
# ============================================================
API_PORT=3001
NODE_ENV=production

# ============================================================
# WEBSITE ACCESS — browser domains allowed to call the API
# ============================================================
CORS_ORIGINS=https://nicepricebazar.com,https://admin.nicepricebazar.com
TRUST_PROXY_HOPS=1
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_BODY_LIMIT=256kb

# ============================================================
# REDIS — dashboard cache and distributed background-job locks
# ============================================================
REDIS_URL=redis://:f1f1daaf2cd508ece4e5273f9d9d67e12ca0626d714cacc627a2ad8772524d20@doublea-redis.aa-redis-ota.svc.cluster.local:6379
REDIS_KEY_PREFIX=nicepricebazar:v1
DASHBOARD_CACHE_TTL_SECONDS=15

# ============================================================
# GOOGLE AUTHENTICATION — OAuth client IDs
# Web is needed for the website; iOS/Android can remain empty now.
# ============================================================
GOOGLE_CLIENT_ID_WEB=1096906009514-3bq49g70p6e5p9u9c7qbo9euaenskijp.apps.googleusercontent.com
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=

# ============================================================
# PUSH NOTIFICATIONS — optional Expo access token
# ============================================================
EXPO_ACCESS_TOKEN=

# ============================================================
# STORE LOCATION — origin for delivery-distance calculations
# ============================================================
STORE_LAT=33.8938
STORE_LNG=35.5018

# ============================================================
# CUSTOMER GPS SECURITY — encrypts exact delivery locations
# LOCATION_ENCRYPTION_KEY must be exactly 64 hexadecimal chars.
# ============================================================
LOCATION_ENCRYPTION_KEY=62ed8877d12e9c553b403a500219560aa0ea24213fc4648e3b975a6b834bc15c
LOCATION_HMAC_SECRET=62ed8877d12e9c553b403a500219560aa0ea24213fc4648e3b975a6b834bc15c
