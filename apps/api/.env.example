# API production environment. Copy to apps/api/.env and fill every placeholder.
NODE_ENV=production
API_PORT=3001

DATABASE_URL=postgresql://bazar_muteren:PASTE_URL_ENCODED_PASSWORD_HERE@doublea-postgres18-ota-rw.aa-postgres18-ota.svc.cluster.local:5432/nicepricebazar-ota-db?schema=bazardb&connection_limit=10&pool_timeout=10&connect_timeout=5&socket_timeout=10&application_name=nicepricebazar_api

# Dashboard cache and distributed background-job locks
REDIS_URL=redis://:PASTE_REDIS_PASSWORD_HERE@PASTE_REDIS_HOST_HERE:6379
REDIS_KEY_PREFIX=nicepricebazar:v1
DASHBOARD_CACHE_TTL_SECONDS=15

JWT_ACCESS_SECRET=PASTE_LONG_RANDOM_ACCESS_SECRET_HERE
JWT_REFRESH_SECRET=PASTE_DIFFERENT_LONG_RANDOM_REFRESH_SECRET_HERE
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

LOCATION_ENCRYPTION_KEY=PASTE_EXACTLY_64_HEXADECIMAL_CHARACTERS_HERE
LOCATION_HMAC_SECRET=PASTE_LONG_RANDOM_LOCATION_HMAC_SECRET_HERE

CORS_ORIGINS=https://nicepricebazar.com,https://admin.nicepricebazar.com
TRUST_PROXY_HOPS=1
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_BODY_LIMIT=256kb

GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
EXPO_ACCESS_TOKEN=

STORE_LAT=33.8938
STORE_LNG=35.5018
