# Database
DATABASE_URL=postgresql://doublea:replace_with_random_password@localhost:5432/doublea_commerce?schema=public&connection_limit=10&pool_timeout=10&connect_timeout=5&socket_timeout=10&application_name=doublea_api
# Use a non-pooled/direct connection for Prisma migrations when your provider supplies one.
DIRECT_DATABASE_URL=postgresql://doublea:replace_with_random_password@localhost:5432/doublea_commerce?schema=public

# JWT
JWT_ACCESS_SECRET=doublea_access_secret_change_in_production
JWT_REFRESH_SECRET=doublea_refresh_secret_change_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Exact GPS at-rest encryption (AES-256-GCM) + HMAC integrity.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LOCATION_ENCRYPTION_KEY=change_me_64_hex_chars_change_me_64_hex_chars_change_me_ab
LOCATION_HMAC_SECRET=change_me_64_hex_chars_change_me_64_hex_chars_change_me_cd

# Google Sign-In (API verifies ID tokens against these audiences)
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=

# Admin (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=1
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_BODY_LIMIT=256kb

# Mobile (Expo)
EXPO_PUBLIC_API_URL=http://localhost:3001/api
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Store origin for delivery distance (optional overrides; defaults to Beirut HQ)
STORE_LAT=33.8938
STORE_LNG=35.5018
# Shared cache, distributed locks, and rate-limit state
REDIS_URL="redis://:change_me@redis:6379"
REDIS_KEY_PREFIX="bazar:v1"
DASHBOARD_CACHE_TTL_SECONDS=15
# Optional unless Expo push security is configured to require an access token
EXPO_ACCESS_TOKEN=
