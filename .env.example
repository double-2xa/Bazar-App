# Database
DATABASE_URL=postgresql://doublea:doublea_secret@localhost:5432/doublea_commerce?schema=public

# JWT
JWT_ACCESS_SECRET=doublea_access_secret_change_in_production
JWT_REFRESH_SECRET=doublea_refresh_secret_change_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Exact GPS at-rest encryption (AES-256-GCM) + HMAC integrity.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LOCATION_ENCRYPTION_KEY=change_me_64_hex_chars_change_me_64_hex_chars_change_me_ab
LOCATION_HMAC_SECRET=change_me_64_hex_chars_change_me_64_hex_chars_change_me_cd

# Google Sign-In (API verifies ID tokens against these audiences)
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=

# Wish Money / Whish Pay (merchant portal credentials)
WHISH_CHANNEL=
WHISH_SECRET=
WHISH_WEBSITE_URL=https://your-registered-domain.com
# sandbox | production
WHISH_ENVIRONMENT=sandbox
# Publicly reachable API base INCLUDING /api (Whish callbacks + app redirects)
# Local sandbox: use a tunnel, e.g. https://xxxx.ngrok-free.app/api
PUBLIC_API_URL=http://localhost:3001/api
IMPORT_IMAGE_TIMEOUT_MS=12000
IMPORT_IMAGE_CONCURRENCY=5

# Admin (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Mobile (Expo)
EXPO_PUBLIC_API_URL=http://localhost:3001/api
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Store origin for delivery distance (optional overrides; defaults to Beirut HQ)
STORE_LAT=33.8938
STORE_LNG=35.5018
